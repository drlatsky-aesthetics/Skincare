# Copy this file to .env and fill in your values

ANTHROPIC_API_KEY=your_anthropic_api_key_here
SECRET_KEY=change_this_to_a_random_secret_key

# GitHub knowledge source
# Set these to pull knowledge files from a GitHub repo folder at startup.
# Leave blank to use the local knowledge/ directory instead.
GITHUB_KNOWLEDGE_REPO=drlatsky-aesthetics/Skincare
GITHUB_KNOWLEDGE_PATH=knowledge
# Personal access token — required for private repos, recommended for public (avoids rate limits)
GITHUB_TOKEN=your_github_token_here
