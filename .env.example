# Copy this file to .env and fill in your values

ANTHROPIC_API_KEY=your_anthropic_api_key_here
SECRET_KEY=change_this_to_a_random_secret_key

# ── Knowledge Hub (highest priority) ───────────────────────────────────────────
# Same shared knowledge base used by the treasury-agent chatbot and the Lumis
# staff CMS — set these so this agent has live pricing instead of its own
# separate, easily-stale copy. Get the values from the treasury-agent /
# agent_knowledge Vercel project env vars (KNOWLEDGE_HUB_URL = the
# agent_knowledge deployment's /api/knowledge-hub URL; KNOWLEDGE_HUB_PASSWORD =
# that project's ADMIN_PASSWORD).
KNOWLEDGE_HUB_URL=https://your-agent-knowledge-deployment.vercel.app/api/knowledge-hub
KNOWLEDGE_HUB_PASSWORD=your_admin_password_here

# ── Google Drive knowledge source (fallback if Hub not configured) ────────────
# Drop PDFs, .md, or .txt files into a shared Drive folder — the agent reads
# them automatically at startup. Folder must be shared as "Anyone with the link".
#
# Setup (~2 min):
#   1. Go to https://console.cloud.google.com/ → create a project
#   2. Enable "Google Drive API"
#   3. Credentials → Create Credentials → API key → copy it here
GOOGLE_DRIVE_FOLDER_ID=1MmTsBm_Y9AgIbfr1u6ds7KayUo7Vf44k
GOOGLE_API_KEY=your_google_api_key_here

# ── GitHub knowledge source (fallback if Drive not configured) ─────────────────
GITHUB_KNOWLEDGE_REPO=drlatsky-aesthetics/Skincare
GITHUB_KNOWLEDGE_PATH=knowledge
GITHUB_TOKEN=your_github_token_here
